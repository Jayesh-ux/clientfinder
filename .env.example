# CLIENTFINDER local configuration. Copy to .env and fill in.
# .env is git-ignored — never commit real secrets.

# Gmail App Password (2FA -> Google Account -> Security -> App passwords).
# Same value works for SMTP (sending) and IMAP (reading replies).
CF_SMTP_PASSWORD=
CF_IMAP_PASSWORD=

# SQLite location. Defaults to <repo>/pipeline/crm.db when unset.
# CLIENTFINDER_DB_PATH=

# Browser channel for the scraper: chrome | msedge | chromium (default: bundled).
# CF_BROWSER_CHANNEL=

# Set to 0 to disable catalog audit writes.
# CLIENTFINDER_AUDIT=1